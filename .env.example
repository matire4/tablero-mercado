# Copiar a .env.local y completar. Ningún valor real va al repo.

# Clave de GNews (plan gratis). Solo se lee en el server, en src/lib/providers/news.ts
NEWS_API_KEY=

# Modo mock (plan B de la demo y base de tests). "true" sirve fixtures desde src/lib/fixtures
USE_MOCK_DATA=false

# Escenario del modo mock: normal | viernes-cerrado | sin-oficial
MOCK_SCENARIO=normal
